                "${workspaceFolder}\\scripts\\windows\\start-pipeline-worker.ps1"
            ],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "weda-services"
            }
        },
        {
            "label": "WEDA: WEB (5173)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
