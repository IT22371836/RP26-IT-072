APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173
FIREBASE_PROJECT_ID=service-e333a
FIREBASE_DATABASE_URL=https://service-e333a-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=service-e333a.firebasestorage.app
FIREBASE_CHECK_REVOKED=true
DOCUMENT_UPLOAD_MAX_BYTES=10485760
# Server only. Point this to a service-account file outside the repository when
# Application Default Credentials are unavailable. Never expose it as a VITE_* value.
GOOGLE_APPLICATION_CREDENTIALS=
PIPELINE_WORKER_ID=weda-pipeline-worker-1
PIPELINE_POLL_INTERVAL_SECONDS=1
PIPELINE_LEASE_SECONDS=90
PIPELINE_WEATHER_TIMEOUT_SECONDS=10
PIPELINE_WEATHER_RETRIES=3
PIPELINE_COMPONENT2_VERSION=firebase-filter-v1
PIPELINE_COMPONENT2_MODEL_VERSION=distance-hours-weather-v1
# Research only. Never configure this in production.
RESEARCH_PROVIDER_PASSWORD=Weda@1234
COMPONENT1_ARTIFACT_DIR=app/components/component1/artifacts
COMPONENT4_ARTIFACT_DIR=../../ml/components/component4/artifacts/catf-v1
COMPONENT4_CATEGORY_PRIORS_PATH=../../ml/components/component4/data/processed/category_priors.json
